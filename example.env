# ── Server ──────────────────────────────────────────────────────────────────
# Use 0.0.0.0 on Render/Docker. API_PORT falls back to PORT (injected by Render).
API_HOST=localhost
API_PORT=3000

NODE_ENV=development
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call the API, e.g.
# https://jerseys4ever.com,https://www.jerseys4ever.com
# localhost:5173/5174 are added automatically outside production.
CORS_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the API and `bun run migrate`.
DATABASE_URL=

# Only read by `bun run generate` (drizzle-kit) — not needed at runtime.
DB_HOST=localhost
DATABASE=jersey
DB_USER=root
DB_PASSWORD=admin

# Only read by the local seed script (src/seed-all.ts) — not needed at runtime.
HASH_SALT=your_salt_here

# Absolute path to the built client (client/dist). Leave unset to auto-resolve
# from the repo layout. In Docker this defaults to /app/client/dist.
# CLIENT_DIST_PATH=/absolute/path/to/client/dist

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key. SERVER ONLY — never ship this to the browser.
# Used for storage and to look up verification state of authenticated users.
# Access tokens are verified against the project's JWKS; no JWT secret is used.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
