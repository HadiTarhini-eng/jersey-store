# Base URL of the backend API, INCLUDING the /api prefix.
# Leave unset in dev: it defaults to /api, which Vite proxies to localhost:3000.
# Production example: https://<your-api-host>/api
# VITE_API_BASE_URL=

# ── Supabase Auth ───────────────────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Publishable "anon" key. Safe to ship to the browser — it is scoped by RLS.
# NEVER put the service-role key (or any other secret) in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=
